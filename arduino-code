/*
  ============================================================
                          RAMBO RUN
  ============================================================
  A Chrome-dinosaur style runner for:
    - Arduino Nano V3
    - HC-SR04 ultrasonic sensor
    - SSD1306 128x64 I2C OLED

  HOW TO PLAY
    Wave your hand over the sensor to START.
    Wave again to make Rambo JUMP over the cacti.
    Watch out for BIRDS: don't jump, and they fly over you.
    Hit anything and it's GAME OVER.
    Wave again to RESTART.

  WIRING
    OLED     VCC -> 5V    GND -> GND   SDA -> A4   SCL -> A5
    HC-SR04  VCC -> 5V    GND -> GND   TRIG -> D9  ECHO -> D10

  LIBRARIES (install from Tools > Manage Libraries)
    "Adafruit SSD1306" and "Adafruit GFX Library"
  ============================================================
*/

#include <Wire.h>
#include <EEPROM.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ---------------- Settings you can tweak ----------------
const int   WAVE_DISTANCE_CM = 15;    // hand closer than this counts as a wave
const float JUMP_POWER       = 5.2;   // bigger number = higher jump
const float GRAVITY          = 0.45;  // bigger number = Rambo falls faster
const float START_SPEED      = 3.0;   // how fast the world scrolls at the start
const float MAX_SPEED        = 5.5;   // the game never goes faster than this
const int   FRAME_MS         = 30;    // time per frame (30 ms is about 33 fps)
const int   BIRD_START_SCORE = 100;   // birds start appearing at this score
const int   BIRD_CHANCE      = 30;    // % chance each new obstacle is a bird

// ---------------- Pins ----------------
const int TRIG_PIN = 9;
const int ECHO_PIN = 10;

// ---------------- Screen ----------------
const int SCREEN_W = 128;
const int SCREEN_H = 64;
const int GROUND_Y = 60;              // y position of the ground line
Adafruit_SSD1306 display(SCREEN_W, SCREEN_H, &Wire, -1);

