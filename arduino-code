const int BIRD_W = 16;
const int BIRD_H = 10;
const int BIRD_Y = 22;   // high enough to miss Rambo on the ground, low enough to hit him mid-jump

// ---------------- Rambo ----------------
const int   RAMBO_X        = 10;            // Rambo stays at this x position
const int   RAMBO_SIZE     = 24;            // sprite is 24 x 24 pixels
const float RAMBO_GROUND_Y = GROUND_Y - RAMBO_SIZE; // y of Rambo's top when standing

float ramboY;
float ramboVelocity;
bool  onGround;
byte  jumpBuffer;   // remembers a wave for a few frames so jumps feel responsive

// ---------------- Obstacles (cacti and birds) ----------------
const int MAX_OBSTACLES = 3;
const int CACTUS_W      = 10;

enum ObstacleType { SMALL_CACTUS, TALL_CACTUS, BIRD };

struct Obstacle {
  float        x;
  ObstacleType type;
  bool         active;   // is it on screen?
};
Obstacle obstacles[MAX_OBSTACLES];
float distToNextObstacle;

// ---------------- Game state ----------------
enum GameState { TITLE, PLAYING, GAME_OVER };
GameState state = TITLE;

float speed;
float distance;
float groundOffset;
unsigned int  score;
unsigned int  highScore;
unsigned long frameCount;
unsigned long lastFrame;
unsigned long gameOverTime;
byte nearCount;     // how many readings in a row the hand has been close


// ============================================================
//                    ULTRASONIC SENSOR
// ============================================================

// Returns distance in cm, or 999 if nothing is in front of the sensor.
int readDistanceCm() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  // Wait at most 6 ms for the echo (about 1 m) so the game doesn't freeze
  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 6000UL);
  if (duration == 0) return 999;
  return duration / 58;
}

// Returns true ONCE each time a hand moves in close to the sensor.
// The hand must be close for 2 readings in a row (ignores random glitches),
// and it must move away again before another wave counts.
bool checkWave() {
  if (readDistanceCm() < WAVE_DISTANCE_CM) {
    if (nearCount < 255) nearCount++;
  } else {
    nearCount = 0;
  }
  return nearCount == 2;
}


// ============================================================
//                       DRAWING
// ============================================================

int cactusHeight(ObstacleType type) {
  return (type == TALL_CACTUS) ? 18 : 12;
}

void drawCactus(int x, int h) {
  int top = GROUND_Y - h;
  display.fillRect(x + 3, top,     4, h, WHITE);  // trunk
  display.fillRect(x,     top + 4, 2, 5, WHITE);  // left arm going up
  display.fillRect(x,     top + 8, 4, 2, WHITE);  // left arm joining trunk
  display.fillRect(x + 8, top + 2, 2, 5, WHITE);  // right arm going up
  display.fillRect(x + 6, top + 6, 4, 2, WHITE);  // right arm joining trunk
}

void drawBird(int x) {
  // Flap the wings every 6 frames
  const unsigned char* sprite = ((frameCount / 6) % 2 == 0) ? birdUp : birdDown;
  display.drawBitmap(x, BIRD_Y, sprite, BIRD_W, BIRD_H, WHITE);
}

void drawWorld() {
  // Ground line with little stones that scroll past
  display.drawFastHLine(0, GROUND_Y, SCREEN_W, WHITE);
  for (int i = 0; i < SCREEN_W + 16; i += 16) {
    int x = i - (int)groundOffset;
    display.drawPixel(x + 3,  GROUND_Y + 2, WHITE);
    display.drawPixel(x + 11, GROUND_Y + 3, WHITE);
  }

  // Cacti and birds
  for (int i = 0; i < MAX_OBSTACLES; i++) {
    if (!obstacles[i].active) continue;
    if (obstacles[i].type == BIRD) {
      drawBird((int)obstacles[i].x);
    } else {
      drawCactus((int)obstacles[i].x, cactusHeight(obstacles[i].type));
    }
  }

  // Rambo: swap frames every 4 frames while running, freeze mid-air
  const unsigned char* sprite = ramboRun1;
  if (onGround && (frameCount / 4) % 2 == 1) sprite = ramboRun2;
  display.drawBitmap(RAMBO_X, (int)ramboY, sprite, RAMBO_SIZE, RAMBO_SIZE, WHITE);

  // Score (left) and high score (right)
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 0);
  display.print(score);
  display.setCursor(74, 0);
  display.print(F("HI "));
  display.print(highScore);
}

void drawTitleScreen() {
  display.clearDisplay();
  display.setTextColor(WHITE);

  display.setTextSize(2);
  display.setCursor(10, 1);
  display.print(F("RAMBO RUN"));

  display.drawBitmap(52, 18, ramboRun1, RAMBO_SIZE, RAMBO_SIZE, WHITE);
  display.drawFastHLine(0, 42, SCREEN_W, WHITE);

  display.setTextSize(1);
  display.setCursor(22, 46);
  display.print(F("Wave to start!"));
  display.setCursor(40, 56);
  display.print(F("HI: "));
  display.print(highScore);

  display.display();
}


// ============================================================
//                       GAME LOGIC
// ============================================================

void startGame() {
  ramboY        = RAMBO_GROUND_Y;
  ramboVelocity = 0;
  onGround      = true;
  jumpBuffer    = 0;

  speed        = START_SPEED;
  distance     = 0;
  score        = 0;
  frameCount   = 0;
  groundOffset = 0;

  for (int i = 0; i < MAX_OBSTACLES; i++) obstacles[i].active = false;
  distToNextObstacle = 60;   // first cactus shows up quickly

  state = PLAYING;
}

void spawnObstacle() {
  for (int i = 0; i < MAX_OBSTACLES; i++) {
    if (!obstacles[i].active) {
      obstacles[i].x = SCREEN_W;
      obstacles[i].active = true;

      if (score >= BIRD_START_SCORE && random(100) < BIRD_CHANCE) {
        obstacles[i].type = BIRD;
      } else if (random(3) == 0) {
        obstacles[i].type = TALL_CACTUS;    // 1 in 3 cacti is a tall one
      } else {
        obstacles[i].type = SMALL_CACTUS;
      }
      return;
    }
  }
}

void updateGame() {
  frameCount++;

  // ----- Jumping and gravity -----
  if (jumpBuffer > 0) jumpBuffer--;
  if (onGround && jumpBuffer > 0) {
    ramboVelocity = -JUMP_POWER;   // negative = upwards on the screen
    onGround = false;
    jumpBuffer = 0;
  }
  if (!onGround) {
    ramboVelocity += GRAVITY;
    ramboY += ramboVelocity;
    if (ramboY >= RAMBO_GROUND_Y) {   // landed
      ramboY = RAMBO_GROUND_Y;
      ramboVelocity = 0;
      onGround = true;
    }
  }

  // ----- Move obstacles left, remove ones that went off screen -----
  for (int i = 0; i < MAX_OBSTACLES; i++) {
    if (obstacles[i].active) {
      obstacles[i].x -= speed;
      if (obstacles[i].x < -BIRD_W) obstacles[i].active = false;
    }
  }

  // ----- Add new obstacles with a random gap (always big enough to react) -----
  distToNextObstacle -= speed;
  if (distToNextObstacle <= 0) {
    spawnObstacle();
    distToNextObstacle = random((long)(speed * 32), (long)(speed * 55));
  }

  // ----- Scroll the ground -----
  groundOffset += speed;
  if (groundOffset >= 16) groundOffset -= 16;

  // ----- Score goes up with distance, and the game speeds up -----
  distance += speed;
  score = (unsigned int)(distance / 10);
  speed = START_SPEED + score / 150.0;
  if (speed > MAX_SPEED) speed = MAX_SPEED;
}

// Checks if Rambo's box overlaps any obstacle's box.
// The boxes are a little smaller than the drawings so near misses feel fair
// (Rambo's horns and antenna, and the bird's wing tips, don't count as hits).
bool hitObstacle() {
  int rx = RAMBO_X + 5;
  int ry = (int)ramboY + 3;
  int rw = 14;
  int rh = 20;

  for (int i = 0; i < MAX_OBSTACLES; i++) {
    if (!obstacles[i].active) continue;

    int ox, oy, ow, oh;
    if (obstacles[i].type == BIRD) {
      ox = (int)obstacles[i].x + 1;
      oy = BIRD_Y + 2;
      ow = BIRD_W - 2;
      oh = 6;
    } else {
      int h = cactusHeight(obstacles[i].type);
      ox = (int)obstacles[i].x + 1;
      oy = GROUND_Y - h + 1;
      ow = CACTUS_W - 2;
      oh = h - 1;
    }

    if (rx < ox + ow && rx + rw > ox && ry < oy + oh && ry + rh > oy) {
      return true;
    }
  }
  return false;
}

void gameOver() {
  state = GAME_OVER;
  gameOverTime = millis();

  bool newBest = score > highScore;
  if (newBest) {
    highScore = score;
    EEPROM.put(0, highScore);   // saved even when the Nano is unplugged
  }

  // Show the final scene with a message box on top
  display.clearDisplay();
  drawWorld();
  display.fillRect(14, 15, 100, 37, BLACK);
  display.drawRect(14, 15, 100, 37, WHITE);

  display.setCursor(37, 19);
  display.print(F("GAME OVER"));
  display.setCursor(newBest ? 22 : 34, 30);
  display.print(newBest ? F("NEW BEST! ") : F("SCORE: "));
  display.print(score);
  display.setCursor(19, 41);
  display.print(F("Wave to restart"));

  display.display();
}


// ============================================================
//                    SETUP AND MAIN LOOP
// ============================================================

void setup() {
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  // If the screen isn't found, blink the Nano's LED forever
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    pinMode(LED_BUILTIN, OUTPUT);
    while (true) {
      digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN));
      delay(200);
    }
  }

  display.setRotation(2);

  randomSeed(analogRead(A0));   // makes obstacle gaps different every game

  EEPROM.get(0, highScore);
  if (highScore == 0xFFFF) highScore = 0;   // brand new Nano has 0xFFFF stored

  drawTitleScreen();
}

void loop() {
  // Run one frame every FRAME_MS milliseconds
  if (millis() - lastFrame < FRAME_MS) return;
  lastFrame = millis();

  bool wave = checkWave();

  if (state == TITLE) {
    if (wave) startGame();
  }
  else if (state == PLAYING) {
    if (wave) jumpBuffer = 6;   // jump now, or as soon as Rambo lands
    updateGame();
    if (hitObstacle()) {
      gameOver();
    } else {
      display.clearDisplay();
      drawWorld();
      display.display();
    }
  }
  else if (state == GAME_OVER) {
    // Short pause so a wave at the moment of the crash doesn't restart instantly
    if (wave && millis() - gameOverTime > 800) startGame();
  }
}
